# Copier vers .env-dev / .env-prod puis renseigner les valeurs réelles.
NODE_ENV=development
PORT=4000

# Secrets OBLIGATOIRES : générer avec `openssl rand -base64 48` (ou équivalent).
JWT_SECRET=remplacez-par-un-secret-long-et-aleatoire
AUDIT_SECRET=remplacez-par-un-autre-secret-long-et-aleatoire

# Sessions
JWT_EXPIRES=15m
REFRESH_TOKEN_DAYS=7

# MongoDB (le nom de base est déduit du chemin de l'URI si MONGO_DB_NAME est absent)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/Copil_Mounir_Dev
# MONGO_DB_NAME=Copil_Mounir_Dev

# Initialisation
AUTO_SEED=false
# Uniquement pour un seed de production volontaire :
# ALLOW_PROD_SEED=1
# SEED_DEMO_PASSWORD=mot-de-passe-de-demo-long

# Réseau / limites (optionnels)
# CORS_ORIGIN=https://copil.example.com
# TRUST_PROXY=1
# RATE_LIMIT_MAX=600
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
